# Copy to .env for LOCAL development only. Never commit a real .env.
# In Databricks, these come from app.yaml + secret scopes, not this file.

# Local Lakebase connection URL (native-password Postgres role).
# postgresql://<role>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
LAKEBASE_URL=

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

EMBEDDING_ENDPOINT=databricks-gte-large-en
CHAT_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

WIKIMEDIA_USER_AGENT=databricks-trip-planner/1.0 (https://github.com/Divyangana7/databricks-trip-planner)
